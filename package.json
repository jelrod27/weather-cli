{
  "name": "weather-cli-16bit",
  "version": "0.5.0",
  "description": "A simple, intelligent weather CLI powered by Open-Meteo — no API key required",
  "main": "index.js",
  "type": "module",
  "bin": {
    "weather": "./bin/weather.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "bin/",
    "src/",
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/weather.js",
    "dev": "node --watch bin/weather.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run test:ci"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "weather",
    "cli",
    "command-line",
    "forecast",
    "temperature",
    "no-quotes",
    "smart-location",
    "open-meteo",
    "no-api-key",
    "location-search",
    "responsive-design",
    "weather-forecast"
  ],
  "author": "16bitweather <justinelrod111@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jelrod27/weather-cli.git"
  },
  "homepage": "https://16bitweather.co",
  "bugs": {
    "url": "https://github.com/jelrod27/weather-cli/issues"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.1",
    "commander": "^14.0.3",
    "inquirer": "^13.4.1",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
